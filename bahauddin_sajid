<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Bahauddin Sajid</title>

<!-- Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<!-- Google Font -->
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">

<style>
:root{
  --card:rgba(20,20,28,.85);
  --text:#fff;
}

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
  font-family:'Poppins',sans-serif;
}

html{
  scroll-behavior:smooth;
  scroll-snap-type:y mandatory;
}

body{
  color:var(--text);
  background:#000;
  overflow-y:scroll;
}

/* ===== 3D CANVAS ===== */
canvas{
  position:fixed;
  inset:0;
  z-index:-1;
}

/* ===== SECTION ===== */
section{
  min-height:100vh;
  scroll-snap-align:start;
  display:flex;
  justify-content:center;
  align-items:center;
  padding:40px 20px;
}

/* ===== CARD ===== */
.card{
  max-width:420px;
  width:100%;
  background:var(--card);
  backdrop-filter:blur(18px);
  border-radius:28px;
  padding:35px;
  text-align:center;
  box-shadow:0 40px 80px rgba(0,0,0,.6);
  animation:fadeUp 1.2s ease;
}

@keyframes fadeUp{
  from{opacity:0;transform:translateY(70px)}
  to{opacity:1;transform:translateY(0)}
}

/* ===== PROFILE ===== */
.profile img{
  width:135px;
  height:135px;
  border-radius:50%;
  object-fit:cover;
  border:4px solid #00f2ff;
  box-shadow:0 0 35px #00f2ff;
  margin-bottom:15px;
}

h1{
  font-size:26px;
  font-weight:700;
}

.bio{
  font-size:14px;
  opacity:.9;
  margin:12px 0 20px;
  line-height:1.6;
}

/* ===== SOCIALS ===== */
.socials{
  display:flex;
  justify-content:center;
  gap:15px;
}

.socials a{
  width:52px;
  height:52px;
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
  color:#fff;
  font-size:22px;
  transition:.4s;
}

.socials a:hover{
  transform:scale(1.18) translateY(-6px);
}

.fb{background:#1877f2}
.ig{background:radial-gradient(circle at 30% 110%,#fdf497,#fd5949,#d6249f,#285AEB)}
.sc{background:#fffc00;color:#000}
.wa{background:#25D366}

/* ===== GALLERY ===== */
.gallery{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:10px;
}

.gallery img{
  width:100%;
  aspect-ratio:1/1;
  border-radius:14px;
  object-fit:cover;
  transition:.4s;
}

.gallery img:hover{
  transform:scale(1.12);
  box-shadow:0 0 20px rgba(0,242,255,.6);
}
</style>
</head>

<body>

<!-- 3D BACKGROUND -->
<canvas id="bg"></canvas>

<!-- PROFILE -->
<section>
  <div class="card">
    <div class="profile">
      <img src="https://uploads.onecompiler.io/4495j76k2/4495hzw8t/IMG_do3ts6.jpg">
