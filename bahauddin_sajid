    <div class="bio">
      و اصبروا إن الله مع الصابرين<br>
      🏵️ صابر 💮 شكر 🌼 توكل
    </div>
    <div class="socials">
      <a class="fb" href="https://www.facebook.com/share/14TLM71Xqb5/" target="_blank"><i class="fa-brands fa-facebook-f"></i></a>
      <a class="ig" href="https://www.instagram.com/the__sjd?igsh=ejV3enJzdG96a3pw" target="_blank"><i class="fa-brands fa-instagram"></i></a>
      <a class="sc" href="https://www.snapchat.com/add/ruthless.mind?share_id=GpwO1fnY54g&locale=en-US" target="_blank"><i class="fa-brands fa-snapchat"></i></a>
      <a class="wa" href="https://wa.me/8801834922000" target="_blank"><i class="fa-brands fa-whatsapp"></i></a>
    </div>
  </div>
</section>

<!-- GALLERY -->
<section>
  <div class="card">
    <h1>Gallery</h1><br>
    <div class="gallery">
      <img src="https://uploads.onecompiler.io/4495j76k2/4498kdxjr/1.jpg">
      <img src="https://uploads.onecompiler.io/4495j76k2/4498kdxjr/2.jpg">
